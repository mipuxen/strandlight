{
  "name": "strandlight",
  "version": "0.1.0",
  "description": "Draw strings of light in the air with your hands, then play them.",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "author": "Khoshimov Shukhratbek",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@fontsource/cormorant": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@mediapipe/tasks-vision": "1.2.3"
  },
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mipuxen/strandlight.git"
  },
  "engines": {
    "node": ">=20"
  }
}
